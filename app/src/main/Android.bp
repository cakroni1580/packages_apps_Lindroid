android_app {
    name: "LindroidUI2",
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,

    srcs: ["java/**/*.java"],

    static_libs: [
        "androidx.appcompat_appcompat",
        "com.google.android.material_material",
        "vendor.lindroid.perspective-java",
        "libaidlcommonsupport",
        "libjni_lindroidui",
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libcutils",
        "libutils",
        "liblog",
        "libui",
        "libgui",
        "libnativewindow",
        "libandroid",
        "libandroid_runtime",
        "vendor.lindroid.composer-ndk",
    ],
}
